{
  "name": "minesweeper",
  "version": "1.0.1",
  "private": true,
  "description": "A compact, classic Minesweeper desktop game",
  "author": "Deaquans",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test desktop/app.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.58.0"
  },
  "build": {
    "appId": "com.deaquans.minesweeper",
    "productName": "Minesweeper",
    "artifactName": "${productName}.${ext}",
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "index.html",
      "style.css",
      "game.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "Deaquans",
      "repo": "minesweeper"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "artifactName": "${productName}.${ext}",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "category": "public.app-category.games"
    }
  }
}
